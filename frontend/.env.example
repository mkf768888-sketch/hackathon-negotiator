VITE_API_BASE=http://localhost:8000

# Аккаунты компаний (опционально — без этих двух переменных экран входа не
# появляется вообще, тренажёр работает как раньше, анонимно).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Лицо аватара: "3d" (по умолчанию, как сейчас), "photo" (реальные фото
# актёра — см. AvatarPhoto.jsx, файлы в public/avatar-photos/) или "video"
# (когда появятся ролики из HeyGen — см. AvatarVideo.jsx).
VITE_AVATAR_MODE=3d
